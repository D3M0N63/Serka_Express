# Cadena de conexión de tu base de datos en Neon (Dashboard de Neon > Connection string).
# Debe incluir "?sslmode=require" al final.
DATABASE_URL=postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Secreto usado para firmar los tokens de sesión. Cambialo por un valor largo y aleatorio.
COURIER_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio
